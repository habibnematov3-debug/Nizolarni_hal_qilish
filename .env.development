# Development muhit konfiguratsiyasi
NODE_ENV=development
PORT=3000

# Ma'lumotlar bazasi
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nizolar_dev_db?schema=public"

# JWT
JWT_SECRET="nizolarni_hal_qilish_dev_secret_key_2026"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Redis (keshlashtirish uchun)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Fayl saqlash
FILE_UPLOAD_PATH="./uploads"
MAX_FILE_SIZE_MB=10

# CORS
CORS_ORIGINS="http://localhost:3001,http://localhost:4200"

# Swagger
SWAGGER_ENABLED=true

# Logging
LOG_LEVEL=debug
