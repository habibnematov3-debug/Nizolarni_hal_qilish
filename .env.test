# Test muhit konfiguratsiyasi
NODE_ENV=test
PORT=3001

# Ma'lumotlar bazasi (alohida test DB)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nizolar_test_db?schema=public"

# JWT
JWT_SECRET="nizolarni_hal_qilish_test_secret_key"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="1d"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Fayl saqlash
FILE_UPLOAD_PATH="./uploads/test"
MAX_FILE_SIZE_MB=5

# CORS
CORS_ORIGINS="http://localhost:3001"

# Swagger
SWAGGER_ENABLED=false

# Logging
LOG_LEVEL=error
