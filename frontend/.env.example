# Set this to the deployed Vercel API origin for Preview and Production.
VITE_API_BASE_URL=https://your-api-project.vercel.app

# Set true only in the Vercel Preview environment for end-to-end test accounts.
VITE_ENABLE_PREVIEW_TEST_LOGIN=false

# Keep browser-side demo roles and browser-only sample records disabled.
VITE_ENABLE_DEMO_MODE=false
