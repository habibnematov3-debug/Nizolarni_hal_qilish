# Stage (UAT) muhit konfiguratsiyasi
NODE_ENV=stage
PORT=3000

# Ma'lumotlar bazasi
DATABASE_URL="postgresql://nizolar_stage_user:CHANGE_ME@stage-db.nizolar.uz:5432/nizolar_stage_db?schema=public&sslmode=require"

# JWT
JWT_SECRET="CHANGE_ME_STRONG_STAGE_SECRET"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Redis
REDIS_HOST=stage-redis.nizolar.uz
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# Fayl saqlash
FILE_UPLOAD_PATH="/app/uploads"
MAX_FILE_SIZE_MB=10

# CORS
CORS_ORIGINS="https://stage.nizolar.uz,https://admin.stage.nizolar.uz"

# Swagger (stage-da yoqilgan)
SWAGGER_ENABLED=true

# Logging
LOG_LEVEL=info
