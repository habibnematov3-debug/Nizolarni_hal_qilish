// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  MINISTRY // Vazirlik
  REGIONAL_DEPARTMENT // Hududiy boshqarma
  TRAINING_CENTER // O'quv markazi
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RegistryStatus {
  NONE // Reyestrda yo'q (Talabgor)
  MEDIATOR // Mediator
  ARBITRATION_JUDGE // Hakamlik sudyasi
  ARBITRATOR // Arbitr
}

enum CabinetType {
  APPLICANT // Talabgor kabineti
  MEDIATOR // Mediator kabineti
  ARBITRATION_JUDGE // Hakamlik sudyasi kabineti
  ARBITRATOR // Arbitr kabineti
  COMMISSION // Malaka komissiyasi kabineti
  REGIONAL_STAFF // Hududiy adliya xodimi kabineti
  MINISTRY_STAFF // Vazirlik xodimi kabineti
  ADMIN // Administrator paneli
  OPERATOR // Operator kabineti
}

enum AuthProvider {
  ONE_ID
  E_SIGN
  MOBILE_ID
  LOCAL
}

enum NotificationChannel {
  CABINET
  SMS
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum TimerUnit {
  MINUTES
  HOURS
  DAYS
  MONTHS
}

enum CourtClaimStatus {
  RECEIVED
  MEDIATOR_ASSIGNED
  IN_PROCESS
  RESOLVED
  RETURNED_TO_COURT
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum IntegrationDirection {
  INBOUND
  OUTBOUND
}

enum IntegrationStatus {
  SUCCESS
  FAILED
  TIMEOUT
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  RETURNED
  ACCEPTED
  FORWARDED
}

enum ReportSummaryStatus {
  DRAFT
  SUBMITTED
}

enum MedApplicationType {
  REGISTRY_REMOVAL
  CERTIFICATE_REPLACEMENT
}

enum MedApplicationStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum CertificateReplacementReason {
  DAMAGED
  LOST
  EXPIRED
  NAME_CHANGED
}

enum CertificateDeliveryMethod {
  PICKUP
  POST
}

enum MkApplicationStatus {
  SUBMITTED
  CHECKING
  ACCEPTED
  REJECTED
  INVITED
  EXAM_IN_PROGRESS
  PASSED
  FAILED
  REGISTERED
}

enum MkExamStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MkCommitteeRole {
  SECRETARY
  MEMBER
}

model Organization {
  id        String           @id @default(uuid())
  name      String
  type      OrganizationType
  parentId  String?          @map("parent_id")
  parent    Organization?    @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Organization[]   @relation("OrganizationHierarchy")
  region    String?
  status    EntityStatus     @default(ACTIVE)
  code      String?
  address   String?
  phone     String?
  email     String?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  users            User[]
  quarterlyReports QuarterlyReport[]
  reportSummaries  ReportSummary[]

  @@map("organizations")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String   @map("display_name")
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  module      String   @default("ADM")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                   String        @id @default(uuid())
  username             String        @unique
  email                String?       @unique
  phone                String?       @unique
  passwordHash         String?       @map("password_hash")
  fullName             String        @map("full_name")
  organizationId       String?       @map("organization_id")
  organization         Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  status               UserStatus    @default(ACTIVE)
  pinfl                String?       @unique
  passportSeriesNumber String?       @map("passport_series_number")
  passportGivenDate    String?       @map("passport_given_date")
  passportExpireDate   String?       @map("passport_expire_date")
  birthDate            String?       @map("birth_date")
  birthPlace           String?       @map("birth_place")
  nationality          String?
  gender               String?
  address              String?
  position             String?

  registryStatus    RegistryStatus @default(NONE) @map("registry_status")
  cabinetType       CabinetType    @default(APPLICANT) @map("cabinet_type")
  authProvider      AuthProvider   @default(LOCAL) @map("auth_provider")
  oneIdUserId       String?        @map("one_id_user_id")
  esignSerialNumber String?        @map("esign_serial_number")
  mobileIdPhone     String?        @map("mobile_id_phone")

  refreshToken String?   @map("refresh_token")
  lastActiveAt DateTime? @map("last_active_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userRoles              UserRole[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  quarterlyReports       QuarterlyReport[]
  createdReportSummaries ReportSummary[]   @relation("ReportSummaryCreator")

  // INT module relations
  disciplineCasesAsMediator DisciplineCase[] @relation("MediatorDiscipline")
  disciplineCasesCreated    DisciplineCase[] @relation("DisciplineCaseCreator")
  dossier                   MediatorDossier? @relation("MediatorDossier")

  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model DictionaryItem {
  id          String   @id @default(uuid())
  category    String // e.g., regions, specializations, penalty_types, case_statuses, contract_templates, exam_questions
  code        String
  nameUz      String   @map("name_uz")
  nameRu      String?  @map("name_ru")
  nameEn      String?  @map("name_en")
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([category, code])
  @@index([category])
  @@map("dictionary_items")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  username     String?
  userFullName String?  @map("user_full_name")
  action       String // CREATE, UPDATE, DELETE, STATUS_CHANGE, LOGIN, LOGOUT, REFRESH, PUBLISH, ROLE_ASSIGN
  entityType   String   @map("entity_type") // ORGANIZATION, USER, ROLE, DICTIONARY, CONTENT, SETTINGS, AUTH, NOTIFICATION, TIMER, INTEGRATION
  entityId     String?  @map("entity_id")
  oldValues    Json?    @map("old_values")
  newValues    Json?    @map("new_values")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entityType])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  group       String   @default("GENERAL") // TIMERS, NOTIFICATIONS, FILE_LIMITS, GENERAL, SESSION, INTEGRATION
  value       Json
  description String?
  updatedBy   String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Content {
  id          String        @id @default(uuid())
  type        String // news, legal_framework, templates, faq, manuals, video_manuals, announcements
  titleUz     String        @map("title_uz")
  titleRu     String?       @map("title_ru")
  titleEn     String?       @map("title_en")
  summaryUz   String?       @map("summary_uz")
  summaryRu   String?       @map("summary_ru")
  summaryEn   String?       @map("summary_en")
  bodyUz      String?       @map("body_uz")
  bodyRu      String?       @map("body_ru")
  bodyEn      String?       @map("body_en")
  fileUrl     String?       @map("file_url")
  videoUrl    String?       @map("video_url")
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")
  authorId    String?       @map("author_id")
  viewCount   Int           @default(0) @map("view_count")
  metadata    Json?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([type])
  @@index([status])
  @@map("contents")
}

model Notification {
  id             String              @id @default(uuid())
  userId         String              @map("user_id")
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel        NotificationChannel @default(CABINET)
  templateCode   String?             @map("template_code")
  title          String
  content        String
  metadata       Json?
  status         NotificationStatus  @default(PENDING)
  isRead         Boolean             @default(false) @map("is_read")
  readAt         DateTime?           @map("read_at")
  sentAt         DateTime?           @map("sent_at")
  failedReason   String?             @map("failed_reason")
  retryCount     Int                 @default(0) @map("retry_count")
  idempotencyKey String?             @unique @map("idempotency_key")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([channel])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationTemplate {
  id                 String   @id @default(uuid())
  code               String   @unique // APPLICATION_STATUS, EXAM_INVITATION, EXAM_RESULT, CONTRACT_STATUS, REPORT_SUBMISSION_DEADLINE, QUALIFICATION_UPGRADE_REMINDER, OBLIGATION_EXECUTION_DEADLINE, CALENDAR_EVENT
  name               String
  category           String   @default("GENERAL") // APPLICATION, EXAM, CONTRACT, REPORT, QUALIFICATION, OBLIGATION, CALENDAR
  titleUz            String   @map("title_uz")
  titleRu            String?  @map("title_ru")
  titleEn            String?  @map("title_en")
  bodyUz             String   @map("body_uz")
  bodyRu             String?  @map("body_ru")
  bodyEn             String?  @map("body_en")
  smsTextUz          String?  @map("sms_text_uz")
  smsTextRu          String?  @map("sms_text_ru")
  availableVariables Json?    @map("available_variables") // ['caseNumber', 'fullName', 'deadline', 'examDate']
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("notification_templates")
}

model TimerSetting {
  id            String    @id @default(uuid())
  key           String    @unique // e.g. CASE_REGISTRATION_TIMEOUT, MEDIATOR_ASSIGNMENT_TIMEOUT, etc.
  name          String
  description   String?
  durationValue Int       @map("duration_value")
  durationUnit  TimerUnit @default(DAYS) @map("duration_unit")
  targetModule  String?   @map("target_module") // MK, MTS, SHA, HIS, MON
  isActive      Boolean   @default(true) @map("is_active")
  updatedBy     String?   @map("updated_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("timer_settings")
}

model CourtClaim {
  id              String           @id @default(uuid())
  courtCaseNumber String           @unique @map("court_case_number")
  courtName       String           @map("court_name")
  judgeName       String?          @map("judge_name")
  claimantName    String           @map("claimant_name")
  claimantPinfl   String?          @map("claimant_pinfl")
  claimantPhone   String?          @map("claimant_phone")
  respondentName  String           @map("respondent_name")
  respondentPinfl String?          @map("respondent_pinfl")
  respondentPhone String?          @map("respondent_phone")
  disputeSubject  String           @map("dispute_subject")
  claimAmount     Decimal?         @map("claim_amount") @db.Decimal(15, 2)
  courtOrderDate  DateTime         @map("court_order_date")
  documentUrl     String?          @map("document_url")
  status          CourtClaimStatus @default(RECEIVED)
  metadata        Json?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([courtCaseNumber])
  @@index([status])
  @@map("court_claims")
}

model TrainingCertificate {
  id                 String   @id @default(uuid())
  certificateNumber  String   @unique @map("certificate_number")
  pinfl              String
  fullName           String   @map("full_name")
  trainingCenterCode String   @map("training_center_code") // YUMOM, TDYU, etc.
  courseName         String   @map("course_name")
  issuedDate         DateTime @map("issued_date")
  expiryDate         DateTime @map("expiry_date")
  status             String   @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  documentUrl        String?  @map("document_url")
  metadata           Json?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([pinfl])
  @@index([certificateNumber])
  @@map("training_certificates")
}

model BillingTransaction {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique @map("invoice_number")
  transactionId   String?       @unique @map("transaction_id") // Payment gateway transaction ID
  userId          String?       @map("user_id")
  amount          Decimal       @db.Decimal(15, 2)
  serviceType     String        @map("service_type") // MEDIATION_FEE, QUALIFICATION_EXAM_FEE, REGISTRY_ENTRY_FEE
  payerPinfl      String?       @map("payer_pinfl")
  payerName       String?       @map("payer_name")
  payerPhone      String?       @map("payer_phone")
  paymentProvider String?       @map("payment_provider") // MUNIS, PAYME, CLICK, TREASURY
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  paidAt          DateTime?     @map("paid_at")
  metadata        Json?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([invoiceNumber])
  @@index([transactionId])
  @@index([paymentStatus])
  @@map("billing_transactions")
}

model IntegrationLog {
  id          String               @id @default(uuid())
  serviceName String               @map("service_name") // ONE_ID, ESIGN, MYGOV, BILLING, COURTS, TRAINING_CENTERS, SMS, LEGAL_CAPACITY, VIDEO, PERSONALIZATION
  direction   IntegrationDirection
  status      IntegrationStatus
  endpoint    String
  request     Json?
  response    Json?
  error       String?
  durationMs  Int?                 @map("duration_ms")
  createdAt   DateTime             @default(now()) @map("created_at")

  @@index([serviceName])
  @@index([status])
  @@index([createdAt])
  @@map("integration_logs")
}

model QuarterlyReport {
  id             String       @id @default(uuid())
  mediatorId     String       @map("mediator_id")
  organizationId String       @map("organization_id")
  periodYear     Int          @map("period_year")
  periodQuarter  Int          @map("period_quarter")
  prefilledData  Json         @map("prefilled_data")
  additionalData Json?        @map("additional_data")
  status         ReportStatus @default(DRAFT)
  returnReason   String?      @map("return_reason")
  submittedAt    DateTime?    @map("submitted_at")
  reviewedAt     DateTime?    @map("reviewed_at")
  forwardedAt    DateTime?    @map("forwarded_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  mediator     User         @relation(fields: [mediatorId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([mediatorId, periodYear, periodQuarter])
  @@index([organizationId, periodYear, periodQuarter])
  @@index([status])
  @@map("quarterly_reports")
}

// ─── Fayl Saqlash Modeli (INFRA-06) ──────────────────────────────────────────
model FileRecord {
  id           String   @id @default(uuid())
  originalName String   @map("original_name")
  storedName   String   @unique @map("stored_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  filePath     String   @map("file_path")
  accessLevel  String   @default("PRIVATE") @map("access_level") // PRIVATE, INTERNAL, PUBLIC
  uploadedById String   @map("uploaded_by_id")
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([uploadedById])
  @@index([accessLevel])
  @@map("file_records")
}

// ─── INT Moduli: Intizomiy javobgarlik va mediator dosyesi ───────────────────

enum DisciplineStatus {
  UNDER_REVIEW   // Ko'rib chiqilmoqda
  SANCTIONED     // Jazo tayinlangan
  ACQUITTED      // Oqlangan
  APPEAL_PENDING // Apellatsiya kutilmoqda
  CLOSED         // Yopilgan
}

enum DisciplineSanctionType {
  WARNING          // Ogohlantirish
  REPRIMAND        // Hayfsan
  STRICT_REPRIMAND // Og'ir hayfsan
  SUSPENSION       // Faoliyatni to'xtatish
  REVOCATION       // Guvohnomani bekor qilish (reyestrdan chiqarish)
}

enum MediatorRegistryStatus {
  ACTIVE    // Faol
  SUSPENDED // To'xtatilgan
  REVOKED   // Chiqarilgan
  PENDING   // Kutilmoqda
}

model DisciplineCase {
  id              String             @id @default(uuid())
  caseNumber      String             @unique
  mediatorId      String
  mediator        User               @relation("MediatorDiscipline", fields: [mediatorId], references: [id])
  status          DisciplineStatus   @default(UNDER_REVIEW)
  openedAt        DateTime           @default(now())
  closedAt        DateTime?
  description     String
  commissionNotes String?
  createdById     String
  createdBy       User               @relation("DisciplineCaseCreator", fields: [createdById], references: [id])
  documents       DisciplineDocument[]
  decision        DisciplineDecision?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([mediatorId])
  @@index([status])
  @@map("discipline_cases")
}

model DisciplineDocument {
  id           String         @id @default(uuid())
  caseId       String
  case         DisciplineCase @relation(fields: [caseId], references: [id])
  fileName     String
  fileUrl      String
  fileSize     Int
  mimeType     String
  uploadedById String
  uploadedAt   DateTime       @default(now())

  @@index([caseId])
  @@map("discipline_documents")
}

model DisciplineDecision {
  id               String                 @id @default(uuid())
  caseId           String                 @unique
  case             DisciplineCase         @relation(fields: [caseId], references: [id])
  sanctionType     DisciplineSanctionType
  decisionDate     DateTime
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  commissionNotes  String?
  registryUpdated  Boolean                @default(false)
  notificationSent Boolean                @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@map("discipline_decisions")
}

model MediatorDossier {
  id                 String                 @id @default(uuid())
  mediatorId         String                 @unique
  mediator           User                   @relation("MediatorDossier", fields: [mediatorId], references: [id])
  registryStatus     MediatorRegistryStatus @default(ACTIVE)
  registeredYear     Int
  region             String
  specialization     String[]
  workExperience     Json?
  achievements       Json?
  trainingCourses    Json?
  qualificationLevel String?
  isPublic            Boolean  @default(false) @map("is_public")
  profileBio          String?  @map("profile_bio")
  videoUrl            String?  @map("video_url")
  media              Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@map("mediator_dossiers")
}

model MedCalendarEvent {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  title        String
  eventDate    DateTime @map("event_date")
  notes        String?
  reminderSent Boolean  @default(false) @map("reminder_sent")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId, eventDate])
  @@map("med_calendar_events")
}

model MedApplication {
  id                       String                    @id @default(uuid())
  userId                   String                    @map("user_id")
  type                     MedApplicationType
  status                   MedApplicationStatus      @default(SUBMITTED)
  reason                   CertificateReplacementReason?
  supportingDocumentId     String?                   @map("supporting_document_id")
  photoFileId              String?                   @map("photo_file_id")
  deliveryMethod           CertificateDeliveryMethod? @map("delivery_method")
  deliveryAddress          String?                   @map("delivery_address")
  decisionNote             String?                   @map("decision_note")
  decidedAt                DateTime?                 @map("decided_at")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")

  @@index([userId, type, status])
  @@map("med_applications")
}

model MedConversation {
  id            String          @id @default(uuid())
  participantA  String          @map("participant_a")
  participantB  String          @map("participant_b")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  messages      MedMessage[]

  @@unique([participantA, participantB])
  @@map("med_conversations")
}

model MedMessage {
  id             String         @id @default(uuid())
  conversationId String         @map("conversation_id")
  senderId       String         @map("sender_id")
  body           String
  attachmentIds  Json?          @map("attachment_ids")
  createdAt      DateTime       @default(now()) @map("created_at")

  conversation MedConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("med_messages")
}

model ReportSummary {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  createdById    String              @map("created_by_id")
  periodYear     Int                 @map("period_year")
  periodQuarter  Int                 @map("period_quarter")
  reportCount    Int                 @default(0) @map("report_count")
  aggregateData  Json                @map("aggregate_data")
  status         ReportSummaryStatus @default(DRAFT)
  submittedAt    DateTime?           @map("submitted_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("ReportSummaryCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([organizationId, periodYear, periodQuarter])
  @@index([periodYear, periodQuarter])
  @@index([status])
  @@map("report_summaries")
}

model MkApplication {
  id                 String             @id @default(uuid())
  applicantId        String             @map("applicant_id")
  status             MkApplicationStatus @default(SUBMITTED)
  phone              String
  email              String?
  address            String?
  profession         String?
  diplomaFileId      String?            @map("diploma_file_id")
  passportFileId     String?            @map("passport_file_id")
  courseCertificateId String?           @map("course_certificate_id")
  passportData       Json?              @map("passport_data")
  autoCheckResult    Json?              @map("auto_check_result")
  rejectionReason    String?            @map("rejection_reason")
  reviewDeadline     DateTime?          @map("review_deadline")
  reviewedById       String?            @map("reviewed_by_id")
  reviewedAt         DateTime?          @map("reviewed_at")
  statusSeen         Boolean            @default(false) @map("status_seen")
  submittedAt        DateTime           @default(now()) @map("submitted_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  exams              MkExam[]

  @@index([applicantId, status])
  @@index([status, reviewDeadline])
  @@map("mk_applications")
}

model MkExam {
  id              String       @id @default(uuid())
  applicationId   String       @map("application_id")
  scheduledAt     DateTime     @map("scheduled_at")
  venue           String
  secretaryPhone  String        @map("secretary_phone")
  status          MkExamStatus  @default(SCHEDULED)
  selectedQuestions Json?       @map("selected_questions")
  protocolFileId  String?       @map("protocol_file_id")
  streamUrl       String?       @map("stream_url")
  archiveUrl      String?       @map("archive_url")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  application     MkApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  assignments     MkExamAssignment[]
  scores          MkExamScore[]

  @@index([applicationId, status])
  @@map("mk_exams")
}

model MkQuestion {
  id          String   @id @default(uuid())
  text        String
  options     Json
  correctOption String? @map("correct_option")
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("mk_questions")
}

model MkCommitteeMember {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  role      MkCommitteeRole
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  assignments MkExamAssignment[]
  @@unique([userId, role])
  @@map("mk_committee_members")
}

model MkExamAssignment {
  id          String            @id @default(uuid())
  examId      String            @map("exam_id")
  memberId    String            @map("member_id")
  assignedAt  DateTime          @default(now()) @map("assigned_at")
  exam        MkExam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  member      MkCommitteeMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  score       MkExamScore?

  @@unique([examId, memberId])
  @@map("mk_exam_assignments")
}

model MkExamScore {
  id           String           @id @default(uuid())
  assignmentId String           @unique @map("assignment_id")
  examId       String           @map("exam_id")
  score        Decimal          @db.Decimal(5, 2)
  comment      String?
  submittedAt DateTime         @default(now()) @map("submitted_at")
  assignment   MkExamAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  exam         MkExam            @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@map("mk_exam_scores")
}
