// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  MINISTRY // Vazirlik
  REGIONAL_DEPARTMENT // Hududiy boshqarma
  TRAINING_CENTER // O'quv markazi
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RegistryStatus {
  NONE // Reyestrda yo'q (Talabgor)
  MEDIATOR // Mediator
  ARBITRATION_JUDGE // Hakamlik sudyasi
  ARBITRATOR // Arbitr
}

enum CabinetType {
  APPLICANT // Talabgor kabineti
  MEDIATOR // Mediator kabineti
  ARBITRATION_JUDGE // Hakamlik sudyasi kabineti
  ARBITRATOR // Arbitr kabineti
  COMMISSION // Malaka komissiyasi kabineti
  REGIONAL_STAFF // Hududiy adliya xodimi kabineti
  MINISTRY_STAFF // Vazirlik xodimi kabineti
  ADMIN // Administrator paneli
  OPERATOR // Operator kabineti
}

enum AuthProvider {
  ONE_ID
  E_SIGN
  MOBILE_ID
  LOCAL
}

enum NotificationChannel {
  CABINET
  SMS
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum TimerUnit {
  MINUTES
  HOURS
  DAYS
  MONTHS
}

enum CourtClaimStatus {
  RECEIVED
  MEDIATOR_ASSIGNED
  IN_PROCESS
  RESOLVED
  RETURNED_TO_COURT
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum IntegrationDirection {
  INBOUND
  OUTBOUND
}

enum IntegrationStatus {
  SUCCESS
  FAILED
  TIMEOUT
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  RETURNED
  ACCEPTED
  FORWARDED
}

enum ReportSummaryStatus {
  DRAFT
  SUBMITTED
}

enum MedApplicationType {
  REGISTRY_REMOVAL
  CERTIFICATE_REPLACEMENT
}

enum MedApplicationStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum CertificateReplacementReason {
  DAMAGED
  LOST
  EXPIRED
  NAME_CHANGED
}

enum CertificateDeliveryMethod {
  PICKUP
  POST
}

enum TrainingCertificateType {
  SPECIAL_COURSE
  QUALIFICATION_UPGRADE
}

enum TrainingApplicationStatus {
  SUBMITTED
  CONTRACT_CREATED
}

enum RegistryType {
  MEDIATOR
  ARBITRATION_JUDGE
  ARBITRATOR
}

enum RegistryEntryStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum ContractType {
  MEDIATION
  ARBITRATION
  ARBITRATION_HEARING
}

enum ServiceContractStatus {
  DRAFT
  PENDING_PARTIES
  RETURNED_FOR_EDIT
  REJECTED
  AWAITING_PROVIDER_APPROVAL
  SIGNED
}

enum ContractPartyRole {
  CLIENT
  COUNTERPARTY
  PROVIDER
}

enum ContractPartyStatus {
  PENDING
  SIGNED
  REJECTED
  RETURNED
}

enum ContractTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MkApplicationStatus {
  SUBMITTED
  CHECKING
  ACCEPTED
  REJECTED
  INVITED
  EXAM_IN_PROGRESS
  PASSED
  FAILED
  REGISTERED
}

enum MkExamStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MkCommitteeRole {
  SECRETARY
  MEMBER
}

enum ObligationStatus {
  PENDING
  DUE_SOON
  COMPLETED
  OVERDUE
}

enum MediationType {
  ONLINE
  MANDATORY
}

enum MediationStatus {
  AWAITING_CONSENT
  MEDIATOR_REQUESTED
  MEDIATOR_ASSIGNED
  AGREEMENT_PENDING_SIGNATURE
  SCHEDULED
  IN_SESSION
  SETTLED
  FAILED
  CLOSED
}

enum ParticipantSide {
  CLAIMANT
  RESPONDENT
}

enum ConsentStatus {
  PENDING
  CONSENTED
  DECLINED
}

enum MedSessionStatus {
  SCHEDULED
  STARTED
  FINISHED
  CANCELLED
}

enum MedResultStatus {
  SETTLED
  NOT_SETTLED
}

model Organization {
  id        String           @id @default(uuid())
  name      String
  type      OrganizationType
  parentId  String?          @map("parent_id")
  parent    Organization?    @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Organization[]   @relation("OrganizationHierarchy")
  region    String?
  status    EntityStatus     @default(ACTIVE)
  code      String?
  address   String?
  phone     String?
  email     String?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  users            User[]
  quarterlyReports QuarterlyReport[]
  reportSummaries  ReportSummary[]

  @@map("organizations")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String   @map("display_name")
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  module      String   @default("ADM")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                   String        @id @default(uuid())
  username             String        @unique
  email                String?       @unique
  phone                String?       @unique
  passwordHash         String?       @map("password_hash")
  fullName             String        @map("full_name")
  organizationId       String?       @map("organization_id")
  organization         Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  status               UserStatus    @default(ACTIVE)
  pinfl                String?       @unique
  passportSeriesNumber String?       @map("passport_series_number")
  passportGivenDate    String?       @map("passport_given_date")
  passportExpireDate   String?       @map("passport_expire_date")
  birthDate            String?       @map("birth_date")
  birthPlace           String?       @map("birth_place")
  nationality          String?
  gender               String?
  address              String?
  position             String?

  registryStatus    RegistryStatus @default(NONE) @map("registry_status")
  cabinetType       CabinetType    @default(APPLICANT) @map("cabinet_type")
  authProvider      AuthProvider   @default(LOCAL) @map("auth_provider")
  oneIdUserId       String?        @map("one_id_user_id")
  esignSerialNumber String?        @map("esign_serial_number")
  mobileIdPhone     String?        @map("mobile_id_phone")

  refreshToken String?   @map("refresh_token")
  lastActiveAt DateTime? @map("last_active_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userRoles              UserRole[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  trainingCertificates   TrainingCertificate[]
  trainingApplications   TrainingApplication[]
  registryEntries        RegistryEntry[]
  contractsCreated       ServiceContract[] @relation("ContractCreator")
  contractsAsProvider    ServiceContract[] @relation("ContractProvider")
  contractParticipants   ContractParticipant[]
  bankDetails            MediatorBankDetails?
  invoicesIssued         ServiceInvoice[] @relation("InvoiceIssuer")
  invoicesPayable        ServiceInvoice[] @relation("InvoicePayer")
  quarterlyReports       QuarterlyReport[]
  createdReportSummaries ReportSummary[]   @relation("ReportSummaryCreator")

  // INT module relations
  disciplineCasesAsMediator DisciplineCase[] @relation("MediatorDiscipline")
  disciplineCasesCreated    DisciplineCase[] @relation("DisciplineCaseCreator")
  dossier                   MediatorDossier? @relation("MediatorDossier")

  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model DictionaryItem {
  id          String   @id @default(uuid())
  category    String // e.g., regions, specializations, penalty_types, case_statuses, contract_templates, exam_questions
  code        String
  nameUz      String   @map("name_uz")
  nameRu      String?  @map("name_ru")
  nameEn      String?  @map("name_en")
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([category, code])
  @@index([category])
  @@map("dictionary_items")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  username     String?
  userFullName String?  @map("user_full_name")
  action       String // CREATE, UPDATE, DELETE, STATUS_CHANGE, LOGIN, LOGOUT, REFRESH, PUBLISH, ROLE_ASSIGN
  entityType   String   @map("entity_type") // ORGANIZATION, USER, ROLE, DICTIONARY, CONTENT, SETTINGS, AUTH, NOTIFICATION, TIMER, INTEGRATION
  entityId     String?  @map("entity_id")
  oldValues    Json?    @map("old_values")
  newValues    Json?    @map("new_values")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entityType])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  group       String   @default("GENERAL") // TIMERS, NOTIFICATIONS, FILE_LIMITS, GENERAL, SESSION, INTEGRATION
  value       Json
  description String?
  updatedBy   String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Content {
  id          String        @id @default(uuid())
  type        String // news, legal_framework, templates, faq, manuals, video_manuals, announcements
  titleUz     String        @map("title_uz")
  titleRu     String?       @map("title_ru")
  titleEn     String?       @map("title_en")
  summaryUz   String?       @map("summary_uz")
  summaryRu   String?       @map("summary_ru")
  summaryEn   String?       @map("summary_en")
  bodyUz      String?       @map("body_uz")
  bodyRu      String?       @map("body_ru")
  bodyEn      String?       @map("body_en")
  fileUrl     String?       @map("file_url")
  videoUrl    String?       @map("video_url")
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")
  authorId    String?       @map("author_id")
  viewCount   Int           @default(0) @map("view_count")
  metadata    Json?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([type])
  @@index([status])
  @@map("contents")
}

model Notification {
  id             String              @id @default(uuid())
  userId         String              @map("user_id")
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel        NotificationChannel @default(CABINET)
  templateCode   String?             @map("template_code")
  title          String
  content        String
  metadata       Json?
  status         NotificationStatus  @default(PENDING)
  isRead         Boolean             @default(false) @map("is_read")
  readAt         DateTime?           @map("read_at")
  sentAt         DateTime?           @map("sent_at")
  failedReason   String?             @map("failed_reason")
  retryCount     Int                 @default(0) @map("retry_count")
  idempotencyKey String?             @unique @map("idempotency_key")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([channel])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationTemplate {
  id                 String   @id @default(uuid())
  code               String   @unique // APPLICATION_STATUS, EXAM_INVITATION, EXAM_RESULT, CONTRACT_STATUS, REPORT_SUBMISSION_DEADLINE, QUALIFICATION_UPGRADE_REMINDER, OBLIGATION_EXECUTION_DEADLINE, CALENDAR_EVENT
  name               String
  category           String   @default("GENERAL") // APPLICATION, EXAM, CONTRACT, REPORT, QUALIFICATION, OBLIGATION, CALENDAR
  titleUz            String   @map("title_uz")
  titleRu            String?  @map("title_ru")
  titleEn            String?  @map("title_en")
  bodyUz             String   @map("body_uz")
  bodyRu             String?  @map("body_ru")
  bodyEn             String?  @map("body_en")
  smsTextUz          String?  @map("sms_text_uz")
  smsTextRu          String?  @map("sms_text_ru")
  availableVariables Json?    @map("available_variables") // ['caseNumber', 'fullName', 'deadline', 'examDate']
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("notification_templates")
}

model TimerSetting {
  id            String    @id @default(uuid())
  key           String    @unique // e.g. CASE_REGISTRATION_TIMEOUT, MEDIATOR_ASSIGNMENT_TIMEOUT, etc.
  name          String
  description   String?
  durationValue Int       @map("duration_value")
  durationUnit  TimerUnit @default(DAYS) @map("duration_unit")
  targetModule  String?   @map("target_module") // MK, MTS, SHA, HIS, MON
  isActive      Boolean   @default(true) @map("is_active")
  updatedBy     String?   @map("updated_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("timer_settings")
}

model CourtClaim {
  id              String           @id @default(uuid())
  courtCaseNumber String           @unique @map("court_case_number")
  courtName       String           @map("court_name")
  judgeName       String?          @map("judge_name")
  claimantName    String           @map("claimant_name")
  claimantPinfl   String?          @map("claimant_pinfl")
  claimantPhone   String?          @map("claimant_phone")
  respondentName  String           @map("respondent_name")
  respondentPinfl String?          @map("respondent_pinfl")
  respondentPhone String?          @map("respondent_phone")
  disputeSubject  String           @map("dispute_subject")
  claimAmount     Decimal?         @map("claim_amount") @db.Decimal(15, 2)
  courtOrderDate  DateTime         @map("court_order_date")
  documentUrl     String?          @map("document_url")
  status          CourtClaimStatus @default(RECEIVED)
  metadata        Json?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([courtCaseNumber])
  @@index([status])
  @@map("court_claims")
}

model TrainingCertificate {
  id                    String                  @id @default(uuid())
  certificateNumber     String                  @unique @map("certificate_number")
  userId                String?                 @map("user_id")
  user                  User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  pinfl                 String
  fullName              String                  @map("full_name")
  certificateType       TrainingCertificateType @default(SPECIAL_COURSE) @map("certificate_type")
  trainingCenterCode    String                  @map("training_center_code") // YUMOM, TDYU, etc.
  courseName            String                  @map("course_name")
  issuedDate            DateTime                @map("issued_date")
  expiryDate            DateTime                @map("expiry_date")
  nextQualificationDate DateTime?               @map("next_qualification_date")
  status                String                  @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  documentUrl           String?                 @map("document_url")
  metadata              Json?
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  @@index([pinfl])
  @@index([userId])
  @@index([certificateType, issuedDate])
  @@index([nextQualificationDate])
  @@index([certificateNumber])
  @@map("training_certificates")
}

model TrainingApplication {
  id                 String                    @id @default(uuid())
  userId             String                    @map("user_id")
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingCenterCode String                    @map("training_center_code")
  courseName         String                    @map("course_name")
  note               String?
  status             TrainingApplicationStatus @default(SUBMITTED)
  contract           TrainingContract?
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([status])
  @@map("training_applications")
}

model TrainingContract {
  id                 String              @id @default(uuid())
  applicationId      String              @unique @map("application_id")
  application        TrainingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  contractNumber     String              @unique @map("contract_number")
  trainingCenterCode String              @map("training_center_code")
  trainingCenterName String              @map("training_center_name")
  mediatorName       String              @map("mediator_name")
  mediatorPinfl      String              @map("mediator_pinfl")
  courseName         String              @map("course_name")
  status             String              @default("GENERATED")
  createdAt          DateTime            @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("training_contracts")
}

model RegistryEntry {
  id                   String              @id @default(uuid())
  userId               String?             @map("user_id")
  user                 User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  registryNumber       String?             @unique @map("registry_number")
  pinfl                String?
  type                 RegistryType
  fullName             String              @map("full_name")
  phone                String?
  email                String?
  address              String?
  region               String
  gender               String?
  birthDate            DateTime?           @map("birth_date") @db.Date
  photoUrl             String?             @map("photo_url")
  education            String?
  specialization       String[]            @default([])
  languages            String[]            @default([])
  latitude             Float?
  longitude            Float?
  certificateNumber    String?             @map("certificate_number")
  certificateIssuedAt  DateTime?           @map("certificate_issued_at")
  certificateExpiresAt DateTime?           @map("certificate_expires_at")
  status               RegistryEntryStatus @default(ACTIVE)
  publicProfile        Boolean             @default(true) @map("public_profile")
  registeredAt         DateTime            @default(now()) @map("registered_at")
  createdById          String?             @map("created_by_id")
  updatedById          String?             @map("updated_by_id")
  deletedAt            DateTime?           @map("deleted_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  statusHistory        RegistryStatusHistory[]
  myGovSyncs           RegistryMyGovSync[]
  ratings              RegistryRating[]

  @@unique([pinfl, type])
  @@unique([userId, type])
  @@index([type, status, region])
  @@index([fullName])
  @@index([gender, birthDate])
  @@index([createdAt])
  @@map("registry_entries")
}

model RegistryStatusHistory {
  id             String              @id @default(uuid())
  registryEntryId String             @map("registry_entry_id")
  registryEntry  RegistryEntry       @relation(fields: [registryEntryId], references: [id], onDelete: Cascade)
  previousStatus RegistryEntryStatus? @map("previous_status")
  status         RegistryEntryStatus
  reason         String?
  changedById    String?             @map("changed_by_id")
  createdAt      DateTime            @default(now()) @map("created_at")

  @@index([registryEntryId, createdAt])
  @@map("registry_status_history")
}

model RegistryImport {
  id          String   @id @default(uuid())
  fileName    String   @map("file_name")
  createdById String   @map("created_by_id")
  totalRows   Int      @default(0) @map("total_rows")
  imported    Int      @default(0)
  duplicates  Int      @default(0)
  errorCount  Int      @default(0) @map("error_count")
  errors      Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdById, createdAt])
  @@map("registry_imports")
}

model RegistryMyGovSync {
  id             String        @id @default(uuid())
  registryEntryId String       @map("registry_entry_id")
  registryEntry  RegistryEntry @relation(fields: [registryEntryId], references: [id], onDelete: Cascade)
  eventType      String        @map("event_type")
  payload        Json
  status         String        @default("PENDING")
  attempts       Int           @default(0)
  nextAttemptAt  DateTime      @default(now()) @map("next_attempt_at")
  lastError      String?       @map("last_error")
  syncedAt       DateTime?     @map("synced_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@index([registryEntryId, createdAt])
  @@map("registry_mygov_syncs")
}

model RegistryRating {
  id             String        @id @default(uuid())
  registryEntryId String       @map("registry_entry_id")
  registryEntry  RegistryEntry @relation(fields: [registryEntryId], references: [id], onDelete: Cascade)
  periodYear     Int           @map("period_year")
  metrics        Json
  score          Float
  methodologyVersion String    @map("methodology_version")
  calculatedAt   DateTime      @default(now()) @map("calculated_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@unique([registryEntryId, periodYear])
  @@index([periodYear, score])
  @@map("registry_ratings")
}

model BillingTransaction {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique @map("invoice_number")
  transactionId   String?       @unique @map("transaction_id") // Payment gateway transaction ID
  userId          String?       @map("user_id")
  amount          Decimal       @db.Decimal(15, 2)
  serviceType     String        @map("service_type") // MEDIATION_FEE, QUALIFICATION_EXAM_FEE, REGISTRY_ENTRY_FEE
  payerPinfl      String?       @map("payer_pinfl")
  payerName       String?       @map("payer_name")
  payerPhone      String?       @map("payer_phone")
  paymentProvider String?       @map("payment_provider") // MUNIS, PAYME, CLICK, TREASURY
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  paidAt          DateTime?     @map("paid_at")
  metadata        Json?
  idempotencyKey  String?      @unique @map("idempotency_key")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  serviceInvoice  ServiceInvoice?

  @@index([invoiceNumber])
  @@index([transactionId])
  @@index([paymentStatus])
  @@map("billing_transactions")
}

model ContractTemplate {
  id          String                 @id @default(uuid())
  type        ContractType
  name        String
  version     Int
  content     String                 @db.Text
  status      ContractTemplateStatus @default(DRAFT)
  createdById String                 @map("created_by_id")
  updatedById String?                @map("updated_by_id")
  publishedAt DateTime?              @map("published_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  contracts   ServiceContract[]

  @@unique([type, version])
  @@index([type, status])
  @@map("contract_templates")
}

model ServiceContract {
  id                       String                   @id @default(uuid())
  contractNumber           String                   @unique @map("contract_number")
  type                     ContractType
  title                    String
  caseSummary              String                   @map("case_summary") @db.Text
  rightsAndResponsibilities String                  @map("rights_and_responsibilities") @db.Text
  terms                    String                   @db.Text
  validUntil               DateTime?                @map("valid_until")
  status                   ServiceContractStatus    @default(DRAFT)
  createdById              String                   @map("created_by_id")
  createdBy                User                     @relation("ContractCreator", fields: [createdById], references: [id], onDelete: Restrict)
  providerId               String                   @map("provider_id")
  provider                 User                     @relation("ContractProvider", fields: [providerId], references: [id], onDelete: Restrict)
  templateId               String?                  @map("template_id")
  template                 ContractTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateVersion          Int?                     @map("template_version")
  templateSnapshot         Json?                    @map("template_snapshot")
  renderedContent          String?                  @map("rendered_content") @db.Text
  sentAt                   DateTime?                @map("sent_at")
  signedAt                 DateTime?                @map("signed_at")
  signedPdf                Bytes?                   @map("signed_pdf") @db.ByteA
  signedPdfSha256           String?                  @map("signed_pdf_sha256")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  participants             ContractParticipant[]
  invoices                 ServiceInvoice[]

  @@index([createdById, status])
  @@index([providerId, status])
  @@index([type, status, validUntil])
  @@map("service_contracts")
}

model ContractParticipant {
  id                    String              @id @default(uuid())
  contractId            String              @map("contract_id")
  contract              ServiceContract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  userId                String?             @map("user_id")
  user                  User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  role                  ContractPartyRole
  fullName              String              @map("full_name")
  pinfl                 String?
  status                ContractPartyStatus @default(PENDING)
  pkcs7                 String?             @db.Text
  signatureVerified     Boolean             @default(false) @map("signature_verified")
  signerSerialNumber    String?             @map("signer_serial_number")
  signedAt              DateTime?           @map("signed_at")
  decisionNote          String?             @map("decision_note")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  @@unique([contractId, role])
  @@index([userId, status])
  @@index([pinfl])
  @@map("contract_participants")
}

model ServiceInvoice {
  id                  String            @id @default(uuid())
  serviceContractId   String            @map("service_contract_id")
  serviceContract     ServiceContract   @relation(fields: [serviceContractId], references: [id], onDelete: Cascade)
  billingTransactionId String           @unique @map("billing_transaction_id")
  billingTransaction  BillingTransaction @relation(fields: [billingTransactionId], references: [id], onDelete: Restrict)
  invoiceNumber       String            @unique @map("invoice_number")
  payerId             String            @map("payer_id")
  payer               User              @relation("InvoicePayer", fields: [payerId], references: [id], onDelete: Restrict)
  issuerId            String            @map("issuer_id")
  issuer              User              @relation("InvoiceIssuer", fields: [issuerId], references: [id], onDelete: Restrict)
  amount              Decimal           @db.Decimal(15, 2)
  currency            String            @default("UZS")
  sentAt              DateTime          @default(now()) @map("sent_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@index([serviceContractId, sentAt])
  @@index([payerId, sentAt])
  @@index([issuerId, sentAt])
  @@map("service_invoices")
}

model MediatorBankDetails {
