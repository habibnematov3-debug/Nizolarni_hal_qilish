  userId         String?         @map("user_id")
  fullName       String          @map("full_name")
  phone          String?
  email          String?
  pinfl          String?
  consentStatus  ConsentStatus   @default(PENDING) @map("consent_status")
  consentedAt    DateTime?       @map("consented_at")
  signaturePkcs7 String?         @map("signature_pkcs7")
