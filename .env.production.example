# Production muhit konfiguratsiyasi — NAMUNA FAYL
# Haqiqiy qiymatlarni bu yerga yozmang!
# Barcha qiymatlar secrets vault yoki CI/CD orqali uzatilsin.

NODE_ENV=production
PORT=3000

# Ma'lumotlar bazasi
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?schema=public&sslmode=require"

# JWT (kamida 64 belgilik tasodifiy string)
JWT_SECRET="YOUR_STRONG_PRODUCTION_SECRET_MIN_64_CHARS"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis
REDIS_HOST=YOUR_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# Fayl saqlash
FILE_UPLOAD_PATH="/app/uploads"
MAX_FILE_SIZE_MB=10

# CORS (faqat ruxsat berilgan domenlar)
CORS_ORIGINS="https://nizolar.uz,https://admin.nizolar.uz"

# Swagger (production-da O'CHIRILGAN bo'lsin)
SWAGGER_ENABLED=false

# Logging
LOG_LEVEL=warn
